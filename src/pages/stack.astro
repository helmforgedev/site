---
// SPDX-License-Identifier: Apache-2.0
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/Container.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { charts } from '../data/charts';
import { Copy, Download, Sparkles, RotateCcw } from 'lucide-astro';

// Sort all charts alphabetically
const sortedCharts = [...charts].sort((a, b) => a.name.localeCompare(b.name));

const categories = [
  { id: 'all', label: 'All Categories' },
  { id: 'database', label: 'Databases' },
  { id: 'ai-machine-learning', label: 'AI & ML' },
  { id: 'streaming-messaging', label: 'Messaging' },
  { id: 'monitoring-logging', label: 'Monitoring' },
  { id: 'security', label: 'Security & IAM' },
  { id: 'networking', label: 'Networking' },
];
---

<BaseLayout
  title="Stack Builder"
  description="Select HelmForge charts and generate ready-to-deploy multi-chart manifests in Helm CLI, OCI, Helmfile, ArgoCD, or FluxCD formats."
>
  <Header />

  <main id="main-content" class="py-16 sm:py-20" data-pagefind-body>
    <Container>
      <SectionHeader
        label="Stack Builder"
        title={
          'Build your stack in clicks, <span class="bg-gradient-to-r from-primary-light via-accent to-accent-light bg-clip-text text-transparent">deploy in seconds.</span>'
        }
        description="Pick the open-source charts you need and instantly generate unified, copy-pasteable manifests for Helm CLI, OCI, Helmfile, ArgoCD, or FluxCD."
      />

      <div class="mt-12 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left: Chart Picker Column -->
        <div class="lg:col-span-5 rounded-3xl border border-border/90 bg-bg-surface/80 p-5 sm:p-6 backdrop-blur-xl shadow-xl">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h3 class="text-base font-bold text-text-base heading-font">Select Charts</h3>
              <p class="text-xs text-text-muted">Choose software for your Kubernetes cluster</p>
            </div>
            <div class="flex items-center gap-2">
              <span
                id="stack-count"
                class="text-xs font-semibold px-2.5 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary-light font-mono"
              >
                0 selected
              </span>
              <button
                id="stack-clear-btn"
                class="hidden items-center gap-1 text-[11px] font-medium text-text-muted hover:text-red-400 transition-colors px-2 py-0.5 rounded hover:bg-bg-base"
                title="Clear all selected charts"
              >
                <RotateCcw class="w-3 h-3" />
                Clear
              </button>
            </div>
          </div>

          <!-- Search Input -->
          <div class="relative mb-3">
            <input
              type="search"
              id="stack-search"
              class="block w-full pl-4 pr-4 py-2.5 border border-border rounded-xl bg-bg-base/80 text-text-base placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-primary-light focus:border-transparent text-sm"
              placeholder="Search 136+ charts by name or slug..."
            />
          </div>

          <!-- Category Filter Pills -->
          <div class="flex flex-wrap gap-1.5 mb-4">
            {categories.map((cat, i) => (
              <button
                class:list={[
                  'stack-cat-filter px-2.5 py-1 rounded-lg text-[11px] font-semibold border transition-all cursor-pointer',
                  i === 0
                    ? 'bg-primary/20 text-primary-light border-primary/40'
                    : 'bg-bg-surface/60 text-text-muted border-border hover:border-primary/30 hover:text-text-base',
                ]}
                data-category={cat.id}
              >
                {cat.label}
              </button>
            ))}
          </div>

          <!-- Chart Scroll List -->
          <div id="stack-chart-list" class="space-y-2 max-h-[500px] overflow-y-auto pr-1.5 scrollbar-thin">
            {sortedCharts.map((chart) => (
              <label
                class="stack-chart-item relative flex items-center gap-3 rounded-2xl border border-border/80 bg-bg-base/40 px-3.5 py-2.5 cursor-pointer transition-all hover:border-primary/40 hover:bg-bg-surface/80 has-[:checked]:border-primary/60 has-[:checked]:bg-primary/5 group"
                data-name={chart.slug}
                data-category={chart.category}
              >
                <input
                  type="checkbox"
                  name="charts"
                  value={chart.slug}
                  class="sr-only stack-checkbox"
                  data-chart-name={chart.name}
                  data-chart-slug={chart.slug}
                  data-chart-category={chart.category}
                />

                <!-- Chart Icon -->
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-bg-surface p-1 border border-border/80 group-hover:border-primary/30 transition-colors">
                  <img
                    src={`/icons/charts/${chart.slug}.png`}
                    alt={chart.name}
                    class="w-full h-full object-contain"
                    loading="lazy"
                    width="28"
                    height="28"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  />
                  <span class="hidden text-xs font-bold text-primary">{chart.name.slice(0, 2).toUpperCase()}</span>
                </div>

                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-1.5">
                    <span class="text-sm font-semibold text-text-base truncate group-hover:text-primary-light transition-colors">
                      {chart.name}
                    </span>
                    <span class="text-[10px] font-mono text-text-muted/80 bg-bg-surface px-1.5 py-0.2 rounded border border-border/60 shrink-0">
                      v{chart.version}
                    </span>
                  </div>
                  <div class="text-[11px] text-text-muted truncate mt-0.5">{chart.description}</div>
                </div>

                <div class="stack-check-icon w-5 h-5 rounded-full border-2 border-border shrink-0 flex items-center justify-center transition-all">
                  <svg class="w-3 h-3 text-white hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
              </label>
            ))}
          </div>
        </div>

        <!-- Right: Output Column -->
        <div class="lg:col-span-7 rounded-3xl border border-border/90 bg-bg-surface/80 p-5 sm:p-6 backdrop-blur-xl shadow-xl flex flex-col justify-between">
          <div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
              <div>
                <h3 class="text-base font-bold text-text-base heading-font">Generated Output</h3>
                <p class="text-xs text-text-muted">Choose your deployment format & export</p>
              </div>

              <!-- Output Action Toolbar -->
              <div class="flex items-center gap-2">
                <button
                  id="stack-download-btn"
                  class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-xl border border-border bg-bg-base/80 hover:border-primary/40 text-text-base hover:text-primary-light transition-all disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
                  disabled
                  title="Download file to disk"
                >
                  <Download class="w-3.5 h-3.5" />
                  Download
                </button>
                <button
                  id="stack-copy-btn"
                  class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-xl bg-primary px-3 py-1.5 text-white hover:bg-primary-dark transition-all disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer shadow-md shadow-primary/20"
                  disabled
                  title="Copy to clipboard"
                >
                  <Copy class="w-3.5 h-3.5" />
                  Copy
                </button>
              </div>
            </div>

            <!-- Format Toggle Pills -->
            <div class="flex flex-wrap gap-1 mb-4 p-1 rounded-2xl bg-bg-base/80 border border-border/80 w-fit">
              <button
                class="stack-format-btn px-3 py-1.5 rounded-xl text-xs font-semibold transition-all bg-primary text-white cursor-pointer"
                data-format="bash"
              >
                Helm Repo
              </button>
              <button
                class="stack-format-btn px-3 py-1.5 rounded-xl text-xs font-semibold transition-all text-text-muted hover:text-text-base cursor-pointer"
                data-format="oci"
              >
                Helm OCI
              </button>
              <button
                class="stack-format-btn px-3 py-1.5 rounded-xl text-xs font-semibold transition-all text-text-muted hover:text-text-base cursor-pointer"
                data-format="helmfile"
              >
                Helmfile
              </button>
              <button
                class="stack-format-btn px-3 py-1.5 rounded-xl text-xs font-semibold transition-all text-text-muted hover:text-text-base cursor-pointer"
                data-format="argocd"
              >
                ArgoCD
              </button>
              <button
                class="stack-format-btn px-3 py-1.5 rounded-xl text-xs font-semibold transition-all text-text-muted hover:text-text-base cursor-pointer"
                data-format="fluxcd"
              >
                FluxCD
              </button>
            </div>

            <!-- Code Display Panel -->
            <div class="rounded-2xl border border-border bg-[#181825] overflow-hidden shadow-2xl">
              <div class="flex items-center justify-between px-4 py-2.5 border-b border-white/5 bg-white/5">
                <div class="flex space-x-1.5">
                  <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></div>
                </div>
                <span id="stack-filename" class="text-[11px] text-zinc-400 font-mono">
                  stack-builder.sh
                </span>
                <span class="text-[10px] text-zinc-400 font-mono">UTF-8</span>
              </div>
              <pre
                id="stack-output"
                class="p-5 font-mono text-xs sm:text-sm text-zinc-300 leading-relaxed overflow-x-auto min-h-[340px]"
              ><code id="stack-code" class="block"><span class="text-zinc-400"># Select charts on the left to generate your install script</span>
<span class="text-zinc-400"># Commands will appear here automatically</span></code></pre>
            </div>

            <!-- Contextual Studio Links Container -->
            <div id="stack-playground-links" class="mt-4" style="display: none;"></div>

            <div id="stack-empty-hint" class="mt-4 text-xs text-text-muted leading-relaxed">
              Select one or more charts on the left to instantly generate install commands. Switch formats above to get
              standard Helm CLI, OCI registry, Helmfile, ArgoCD, or FluxCD manifests.
            </div>
          </div>
        </div>
      </div>

      <!-- Preset Stacks Section -->
      <div class="mt-20">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 pb-4 border-b border-border/80">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary-dark dark:text-primary-light text-xs font-bold uppercase tracking-wider mb-2">
              <Sparkles class="w-3.5 h-3.5" />
              Curated Architectural Presets
            </div>
            <h3 class="text-2xl font-extrabold text-text-base heading-font">Popular Production Stacks</h3>
            <p class="text-sm text-text-muted mt-1">
              One-click architectural compositions for common workloads, pre-tested for Kubernetes reliability.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <button
            class="stack-preset glass-panel rounded-2xl p-5 text-left transition-all hover:border-primary/40 hover:-translate-y-0.5 group cursor-pointer"
            data-charts="postgresql,redis,n8n"
          >
            <div class="flex items-center justify-between mb-1.5">
              <div class="text-sm font-bold text-text-base group-hover:text-primary-light transition-colors">
                Automation Stack
              </div>
              <span class="text-[10px] font-mono text-text-muted bg-bg-surface px-2 py-0.5 rounded border border-border/60">
                3 charts
              </span>
            </div>
            <p class="text-xs text-text-muted">PostgreSQL + Redis + n8n</p>
          </button>

          <button
            class="stack-preset glass-panel rounded-2xl p-5 text-left transition-all hover:border-primary/40 hover:-translate-y-0.5 group cursor-pointer"
            data-charts="postgresql,redis,keycloak"
          >
            <div class="flex items-center justify-between mb-1.5">
              <div class="text-sm font-bold text-text-base group-hover:text-primary-light transition-colors">
                Auth & IAM Stack
              </div>
              <span class="text-[10px] font-mono text-text-muted bg-bg-surface px-2 py-0.5 rounded border border-border/60">
                3 charts
              </span>
            </div>
            <p class="text-xs text-text-muted">PostgreSQL + Redis + Keycloak</p>
          </button>

          <button
            class="stack-preset glass-panel rounded-2xl p-5 text-left transition-all hover:border-primary/40 hover:-translate-y-0.5 group cursor-pointer"
            data-charts="mysql,wordpress,redis"
          >
            <div class="flex items-center justify-between mb-1.5">
              <div class="text-sm font-bold text-text-base group-hover:text-primary-light transition-colors">
                CMS & Publishing Stack
              </div>
              <span class="text-[10px] font-mono text-text-muted bg-bg-surface px-2 py-0.5 rounded border border-border/60">
                3 charts
              </span>
            </div>
            <p class="text-xs text-text-muted">MySQL + WordPress + Redis</p>
          </button>

          <button
            class="stack-preset glass-panel rounded-2xl p-5 text-left transition-all hover:border-primary/40 hover:-translate-y-0.5 group cursor-pointer"
            data-charts="postgresql,gitea,redis"
          >
            <div class="flex items-center justify-between mb-1.5">
              <div class="text-sm font-bold text-text-base group-hover:text-primary-light transition-colors">
                DevOps Platform Stack
              </div>
              <span class="text-[10px] font-mono text-text-muted bg-bg-surface px-2 py-0.5 rounded border border-border/60">
                3 charts
              </span>
            </div>
            <p class="text-xs text-text-muted">PostgreSQL + Gitea + Redis</p>
          </button>

          <button
            class="stack-preset glass-panel rounded-2xl p-5 text-left transition-all hover:border-primary/40 hover:-translate-y-0.5 group cursor-pointer"
            data-charts="postgresql,redis,flowise"
          >
            <div class="flex items-center justify-between mb-1.5">
              <div class="text-sm font-bold text-text-base group-hover:text-primary-light transition-colors">
                AI Agent Pipeline Stack
              </div>
              <span class="text-[10px] font-mono text-text-muted bg-bg-surface px-2 py-0.5 rounded border border-border/60">
                3 charts
              </span>
            </div>
            <p class="text-xs text-text-muted">PostgreSQL + Redis + Flowise</p>
          </button>

          <button
            class="stack-preset glass-panel rounded-2xl p-5 text-left transition-all hover:border-primary/40 hover:-translate-y-0.5 group cursor-pointer"
            data-charts="pihole,cloudflared,uptime-kuma"
          >
            <div class="flex items-center justify-between mb-1.5">
              <div class="text-sm font-bold text-text-base group-hover:text-primary-light transition-colors">
                HomeLab & Network Stack
              </div>
              <span class="text-[10px] font-mono text-text-muted bg-bg-surface px-2 py-0.5 rounded border border-border/60">
                3 charts
              </span>
            </div>
            <p class="text-xs text-text-muted">Pi-hole + Cloudflared + Uptime Kuma</p>
          </button>

          <button
            class="stack-preset glass-panel rounded-2xl p-5 text-left transition-all hover:border-primary/40 hover:-translate-y-0.5 group cursor-pointer"
            data-charts="qdrant,open-webui,text-embeddings-inference"
          >
            <div class="flex items-center justify-between mb-1.5">
              <div class="text-sm font-bold text-text-base group-hover:text-primary-light transition-colors">
                Local LLM & RAG Stack
              </div>
              <span class="text-[10px] font-mono text-text-muted bg-bg-surface px-2 py-0.5 rounded border border-border/60">
                3 charts
              </span>
            </div>
            <p class="text-xs text-text-muted">Qdrant + Open WebUI + Text Embeddings</p>
          </button>

          <button
            class="stack-preset glass-panel rounded-2xl p-5 text-left transition-all hover:border-primary/40 hover:-translate-y-0.5 group cursor-pointer"
            data-charts="metrics-server,uptime-kuma,changedetection"
          >
            <div class="flex items-center justify-between mb-1.5">
              <div class="text-sm font-bold text-text-base group-hover:text-primary-light transition-colors">
                Observability & Ops Stack
              </div>
              <span class="text-[10px] font-mono text-text-muted bg-bg-surface px-2 py-0.5 rounded border border-border/60">
                3 charts
              </span>
            </div>
            <p class="text-xs text-text-muted">Metrics Server + Uptime Kuma + changedetection.io</p>
          </button>

          <button
            class="stack-preset glass-panel rounded-2xl p-5 text-left transition-all hover:border-primary/40 hover:-translate-y-0.5 group cursor-pointer"
            data-charts="postgresql,redis,nextcloud"
          >
            <div class="flex items-center justify-between mb-1.5">
              <div class="text-sm font-bold text-text-base group-hover:text-primary-light transition-colors">
                Private Cloud Workspace
              </div>
              <span class="text-[10px] font-mono text-text-muted bg-bg-surface px-2 py-0.5 rounded border border-border/60">
                3 charts
              </span>
            </div>
            <p class="text-xs text-text-muted">PostgreSQL + Redis + Nextcloud</p>
          </button>
        </div>
      </div>
    </Container>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../scripts/stack-builder';
</script>
