---
// SPDX-License-Identifier: Apache-2.0
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import HomeChartRequest from '../components/HomeChartRequest.astro';
import SupportSection from '../components/SupportSection.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import EcosystemLogos from '../components/EcosystemLogos.astro';
import Footer from '../components/Footer.astro';
import { chartCount } from '../data/charts';
---

<BaseLayout
  title="HelmForge — The Open-Source Alternative to Bitnami"
  description={`HelmForge — ${chartCount}+ production-ready Helm charts for Kubernetes. The open-source, Apache-2.0-licensed alternative to Bitnami. Official upstream images, automated S3 backup, non-root security, zero vendor lock-in. Free forever.`}
>
  <Header />
  <main id="main-content">
    <Hero />
    <Features />
    <ComparisonTable />
    <HomeChartRequest />
    <SupportSection />
    <EcosystemLogos />
  </main>
  <Footer />
</BaseLayout>
