---
// SPDX-License-Identifier: Apache-2.0
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/Container.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { chartCount } from '../data/charts';

const communityStats = [
  { value: `${chartCount}+`, label: 'Production Charts', highlight: '100% Pinned Digests' },
  { value: 'Apache-2.0', label: 'Open Source', highlight: 'Zero Proprietary Layers' },
  { value: '20-Layer', label: 'Quality Gate', highlight: 'Automated k3d Tests' },
  { value: '100%', label: 'Request Delivery', highlight: 'Zero Backlog Guarantee' },
];

const ways = [
  {
    icon: 'chart',
    title: 'Submit a Chart',
    description:
      'Build and contribute a production-grade Helm chart using official pinned images, non-root security, and S3 backup integration.',
    link: 'https://github.com/helmforgedev/charts/blob/main/CONTRIBUTING.md',
    linkText: 'Read CONTRIBUTING.md',
  },
  {
    icon: 'request',
    title: 'Request a Chart',
    description:
      'Need an application packaged? Submit a community request. We evaluate demand, upstream image quality, and deliver with automated CI.',
    link: '/request',
    linkText: 'Open Request Hub',
  },
  {
    icon: 'test',
    title: 'Test & Review',
    description:
      'Run `./test.sh <chart>` on local k3d clusters, review open pull requests, and report production edge cases.',
    link: 'https://github.com/helmforgedev/charts/pulls',
    linkText: 'Explore Open PRs',
  },
  {
    icon: 'bug',
    title: 'Report Issues',
    description:
      'Found unexpected behavior, security vulnerability, or upstream image drift? Open an issue with reproduction steps.',
    link: 'https://github.com/helmforgedev/charts/issues/new',
    linkText: 'Report an issue',
  },
  {
    icon: 'docs',
    title: 'Improve Documentation',
    description:
      'Help improve architecture guides, deployment scenarios, values schemas, and operational troubleshooting playbooks.',
    link: 'https://github.com/helmforgedev/site',
    linkText: 'Contribute to Docs',
  },
  {
    icon: 'star',
    title: 'Spread the Word',
    description:
      'Star the repository on GitHub, share HelmForge in Kubernetes communities, or write about your self-hosted setup.',
    link: 'https://github.com/helmforgedev/charts',
    linkText: 'Star on GitHub',
  },
];

const iconPaths: Record<string, string> = {
  chart:
    'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z',
  bug: 'M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  request: 'M12 4v16m8-8H4',
  docs: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  test: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4',
  star: 'M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z',
};

const governance = [
  {
    label: 'License',
    value: 'Apache-2.0',
    description: '100% open-source under Apache-2.0. No open-core split, no paywalls, free forever for any workload.',
  },
  {
    label: 'Versioning',
    value: 'Strict SemVer',
    description: 'Automated semantic versioning managed strictly by CI based on scoped Conventional Commits.',
  },
  {
    label: 'Integrity',
    value: 'GPG + Cosign',
    description: 'Every release includes GPG provenance signatures and keyless Sigstore Cosign verification on GHCR.',
  },
  {
    label: 'Security',
    value: 'Zero-Root Contract',
    description:
      'Mandatory non-root UID 10001+, drop all Linux capabilities, and immutable read-only root filesystems.',
  },
];

const requestSteps = [
  {
    step: '1',
    title: 'Submit Request',
    description: 'Open a request through the community hub or GitHub with upstream container details.',
  },
  {
    step: '2',
    title: 'Maintainer Audit',
    description: 'We verify official image provenance, multi-arch support, CVE posture, and volume lifecycles.',
  },
  {
    step: '3',
    title: 'k3d Validation',
    description: 'Chart is scaffolded and tested end-to-end on local k3d with real secrets, backups, and ingress.',
  },
  {
    step: '4',
    title: 'Signed Release',
    description: 'Signed with Cosign and published simultaneously to HTTPS Helm repo and OCI registry.',
  },
];
---

<BaseLayout
  title="Community — Built in the Open, Shaped by Kubernetes Operators"
  description="Join the HelmForge community. Contribute production-ready Helm charts, report issues, test runtime behaviors, and help build the open-source alternative to Bitnami."
>
  <Header />
  <main id="main-content" class="py-16 sm:py-24" data-pagefind-body>
    <Container>
      <!-- Section Header -->
      <SectionHeader
        as="h1"
        label="Community"
        title="Built in the open, shaped by operators."
        description="HelmForge is an open-source, community-driven ecosystem. We build reliable, verifiable, vendor-neutral Kubernetes tooling for teams worldwide."
      />

      <!-- Metrics Bar -->
      <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-4">
        {communityStats.map((stat) => (
          <div class="glass-panel rounded-2xl p-5 border border-border/70 text-center flex flex-col justify-center">
            <div class="text-2xl sm:text-3xl font-extrabold text-primary-light font-mono">{stat.value}</div>
            <div class="text-xs sm:text-sm font-bold text-text-base mt-1">{stat.label}</div>
            <div class="text-[11px] text-text-muted mt-0.5">{stat.highlight}</div>
          </div>
        ))}
      </div>

      <!-- How to Contribute -->
      <div class="mt-16">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold text-text-base heading-font">How to contribute</h2>
          <span class="text-xs font-semibold text-text-muted">PRs always welcome</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {ways.map((way) => (
            <div class="glass-panel rounded-2xl p-6 flex flex-col transition-all hover:border-primary/40 hover:-translate-y-0.5">
              <div class="flex items-center gap-3.5 mb-3.5">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary-light shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={iconPaths[way.icon]} />
                  </svg>
                </div>
                <h3 class="text-base font-bold text-text-base">{way.title}</h3>
              </div>
              <p class="text-xs text-text-muted leading-relaxed flex-1">{way.description}</p>
              <a
                href={way.link}
                target={way.link.startsWith('/') ? undefined : '_blank'}
                rel={way.link.startsWith('/') ? undefined : 'noopener noreferrer'}
                class="mt-4 inline-flex items-center gap-1.5 text-xs font-bold text-primary-light hover:underline"
              >
                {way.linkText}
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </a>
            </div>
          ))}
        </div>
      </div>

      <!-- Chart Request Process -->
      <div class="mt-16">
        <h2 class="text-xl font-bold text-text-base heading-font mb-6">Chart request pipeline</h2>
        <div class="glass-panel rounded-2xl p-6 sm:p-8">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {requestSteps.map((s) => (
              <div class="flex flex-col items-center text-center">
                <div class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-primary text-white text-sm font-extrabold shadow-md shadow-primary/20 mb-3">
                  {s.step}
                </div>
                <h3 class="text-sm font-bold text-text-base">{s.title}</h3>
                <p class="mt-1.5 text-xs text-text-muted leading-relaxed">{s.description}</p>
              </div>
            ))}
          </div>
          <div class="mt-8 pt-6 border-t border-border/50 text-center">
            <a
              href="/request"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-bold bg-primary text-white hover:bg-primary-dark transition-all shadow-sm"
            >
              Open a Chart Request
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Governance & Standards -->
      <div class="mt-16">
        <h2 class="text-xl font-bold text-text-base heading-font mb-6">Governance & standards</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {governance.map((g) => (
            <div class="glass-panel rounded-2xl p-6">
              <div class="flex items-center gap-2 mb-2.5">
                <span class="text-xs font-bold uppercase tracking-[0.16em] text-text-muted">{g.label}</span>
                <span class="text-xs font-mono font-bold text-primary-light bg-primary/10 border border-primary/20 px-2.5 py-0.5 rounded-full">
                  {g.value}
                </span>
              </div>
              <p class="text-xs sm:text-sm text-text-muted leading-relaxed">{g.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Contributors Section -->
      <div id="contributors-section" class="mt-16">
        <h2 class="text-xl font-bold text-text-base heading-font mb-6">Contributors</h2>
        <div class="glass-panel rounded-2xl p-6 sm:p-8 text-center">
          <p class="max-w-2xl mx-auto text-sm text-text-muted leading-relaxed mb-6">
            HelmForge is shaped and maintained by independent engineers across the globe. Every chart patch,
            documentation correction, and security review helps build transparent, enterprise-ready Kubernetes
            packaging.
          </p>
          <div class="flex justify-center mb-6">
            <a
              href="https://github.com/helmforgedev/charts/graphs/contributors"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="View HelmForge contributors on GitHub"
            >
              <img
                src="https://repo.helmforge.dev/badges/contributors.svg"
                alt="HelmForge contributors"
                class="max-w-full rounded-xl shadow-sm"
                loading="lazy"
              />
            </a>
          </div>
          <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-semibold">
            <a
              href="https://github.com/helmforgedev/charts/graphs/contributors"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-primary-light hover:underline"
            >
              View contributor graph on GitHub
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                />
              </svg>
            </a>
            <span class="text-border">|</span>
            <a
              href="https://github.com/helmforgedev/charts/blob/main/CODE_OF_CONDUCT.md"
              target="_blank"
              rel="noopener noreferrer"
              class="text-text-muted hover:text-text-base"
            >
              Code of Conduct
            </a>
          </div>
        </div>
      </div>

      <!-- Global CTA -->
      <div class="mt-16 text-center">
        <a
          href="https://github.com/helmforgedev/charts"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 rounded-full bg-primary px-7 py-3.5 text-sm font-bold text-white transition-all hover:bg-primary-dark hover:shadow-lg hover:shadow-primary/25"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"></path>
          </svg>
          Star HelmForge on GitHub
        </a>
      </div>
    </Container>
  </main>
  <Footer />
</BaseLayout>
