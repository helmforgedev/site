---
// SPDX-License-Identifier: Apache-2.0
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Container from '../../components/Container.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import {
  acquisitionSources,
  consoleChecks,
  discoveryProperties,
  monitoringCadence,
  officialMonitoringLinks,
  perPostMetrics,
} from '../../data/analyticsMonitoring';

const monitoringJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'HelmForge Blog Discovery Monitoring',
  url: 'https://helmforge.dev/blog/monitoring',
  about: 'Search, Discover, Bing, RSS, and Core Web Vitals monitoring workflow for the HelmForge blog',
};

const vitalsTargets = [
  { metric: 'LCP', target: '< 2.5s', status: 'Optimal', label: 'Largest Contentful Paint' },
  { metric: 'CLS', target: '< 0.1', status: 'Optimal', label: 'Cumulative Layout Shift' },
  { metric: 'INP', target: '< 200ms', status: 'Optimal', label: 'Interaction to Next Paint' },
  { metric: 'A11y', target: '100% (WCAG 2.2 AA)', status: 'Verified', label: 'axe-core Automated Gate' },
];
---

<BaseLayout
  title="Blog Discovery & Performance Monitoring — HelmForge"
  description="HelmForge blog discovery monitoring workflow: Google Search Console, Bing Webmaster Tools, IndexNow, Core Web Vitals, and accessibility invariants."
  ogType="website"
>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(monitoringJsonLd)}></script>
  <main id="main-content" class="py-16 sm:py-24" data-pagefind-body>
    <Container>
      <!-- Section Header -->
      <SectionHeader
        label="Analytics & Monitoring"
        as="h1"
        title="Discovery & performance monitoring."
        description="A repeatable operating dashboard for search engine indexing, traffic source quality, image discovery, and Core Web Vitals performance."
      />

      <!-- Core Web Vitals Target Cards -->
      <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-4">
        {vitalsTargets.map((vital) => (
          <div class="glass-panel rounded-2xl p-5 border border-border text-center flex flex-col justify-center">
            <div class="text-xs font-bold uppercase tracking-wider text-text-muted">{vital.label}</div>
            <div class="text-2xl font-mono font-bold text-text-base mt-1.5">{vital.metric}</div>
            <div class="mt-1 inline-flex items-center justify-center gap-1.5 text-xs font-bold text-emerald-800 dark:text-emerald-300">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              {vital.target}
            </div>
          </div>
        ))}
      </div>

      <!-- Properties Grid -->
      <section class="mt-14" aria-labelledby="properties-heading">
        <h2 id="properties-heading" class="heading-font text-xl font-bold text-text-base mb-6">
          Canonical discovery endpoints
        </h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div class="glass-panel rounded-2xl p-5 border border-border">
            <div class="text-xs font-bold uppercase tracking-[0.16em] text-primary">Canonical Site</div>
            <a
              class="mt-2.5 block break-words text-sm font-mono font-semibold text-text-base hover:text-primary transition-colors"
              href="/"
            >
              {discoveryProperties.canonicalSite}
            </a>
          </div>
          <div class="glass-panel rounded-2xl p-5 border border-border">
            <div class="text-xs font-bold uppercase tracking-[0.16em] text-primary">Sitemap Index</div>
            <a
              class="mt-2.5 block break-words text-sm font-mono font-semibold text-text-base hover:text-primary transition-colors"
              href="/sitemap-index.xml"
            >
              {discoveryProperties.sitemapIndex}
            </a>
          </div>
          <div class="glass-panel rounded-2xl p-5 border border-border">
            <div class="text-xs font-bold uppercase tracking-[0.16em] text-primary">Atom & RSS Feed</div>
            <a
              class="mt-2.5 block break-words text-sm font-mono font-semibold text-text-base hover:text-primary transition-colors"
              href="/blog/rss.xml"
            >
              {discoveryProperties.blogFeed}
            </a>
          </div>
        </div>
      </section>

      <!-- Search Console Checklists -->
      <section class="mt-14" aria-labelledby="console-heading">
        <h2 id="console-heading" class="heading-font text-xl font-bold text-text-base mb-6">
          Console & indexing verification
        </h2>
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
          {consoleChecks.map((group) => (
            <article class="glass-panel rounded-2xl p-6 border border-border flex flex-col">
              <div class="flex items-center justify-between mb-3">
                <span class="text-[11px] font-bold uppercase tracking-wider text-primary-light bg-primary/10 border border-primary/20 px-2.5 py-0.5 rounded-full">
                  {group.status}
                </span>
              </div>
              <h3 class="text-base font-bold text-text-base heading-font">{group.tool}</h3>
              <ul class="mt-4 space-y-2.5 text-xs sm:text-sm leading-relaxed text-text-muted flex-1">
                {group.checks.map((check) => (
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-500 font-bold shrink-0">✓</span>
                    <span>{check}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <!-- Cadence & Segmentation Grid -->
      <section class="mt-14 grid grid-cols-1 gap-8 lg:grid-cols-12 items-start">
        <div class="lg:col-span-7">
          <h2 class="heading-font text-xl font-bold text-text-base mb-6">Review cadence</h2>
          <div class="overflow-hidden rounded-2xl border border-border glass-panel">
            <table class="w-full text-left text-xs sm:text-sm">
              <thead class="bg-bg-muted/80 text-[11px] uppercase tracking-[0.16em] text-text-muted border-b border-border">
                <tr>
                  <th class="px-4 py-3 font-bold">Cadence</th>
                  <th class="px-4 py-3 font-bold">Owner</th>
                  <th class="px-4 py-3 font-bold">Focus</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border/60">
                {monitoringCadence.map((item) => (
                  <tr class="hover:bg-bg-surface/50 transition-colors">
                    <td class="px-4 py-3.5 font-semibold text-text-base font-mono">{item.cadence}</td>
                    <td class="px-4 py-3.5 text-text-muted">{item.owner}</td>
                    <td class="px-4 py-3.5 text-text-muted">{item.focus}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div class="lg:col-span-5">
          <h2 class="heading-font text-xl font-bold text-text-base mb-6">Traffic segmentation</h2>
          <div class="glass-panel rounded-2xl p-6 border border-border space-y-2.5">
            {acquisitionSources.map((source) => (
              <div class="flex items-center justify-between p-2.5 rounded-xl bg-bg-surface/60 border border-border/70 text-xs font-semibold text-text-base">
                <span>{source}</span>
                <span class="text-[11px] text-text-muted font-mono">UTM Monitored</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Per-Post Invariants -->
      <section class="mt-14" aria-labelledby="metrics-heading">
        <h2 id="metrics-heading" class="heading-font text-xl font-bold text-text-base mb-6">
          Per-post quality metrics
        </h2>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {perPostMetrics.map((metric) => (
            <div class="glass-panel rounded-xl border border-border p-3.5 text-xs text-text-muted flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span>
              <span>{metric}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Official References -->
      <section class="mt-14" aria-labelledby="references-heading">
        <h2 id="references-heading" class="heading-font text-xl font-bold text-text-base mb-6">
          Official references & tooling
        </h2>
        <div class="flex flex-wrap gap-3">
          {officialMonitoringLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-xl border border-border bg-bg-surface px-4 py-2.5 text-xs font-bold text-text-base transition-colors hover:border-primary/40 hover:text-primary-light shadow-sm"
            >
              {link.label}
            </a>
          ))}
        </div>
      </section>
    </Container>
  </main>
  <Footer />
</BaseLayout>
