                    <CheckCircle2 class="w-3.5 h-3.5" />
                    {pillar.version}
                  </span>
                </div>

                <div class="mt-6 pt-5 border-t border-border/60">
                  <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    {pillar.items.map((item) => (
                      <li class="flex items-start gap-2.5 text-xs sm:text-sm text-text-muted">
                        <CheckCircle2 class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" />
                        <span class="leading-relaxed">{item.text}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <!-- SECTION 2: CURRENT FOCUS (ACTIVE / IN PROGRESS) -->
      <section id="active" class="mt-24 scroll-mt-24">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 pb-4 border-b border-border/80">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary-dark dark:text-primary-light text-xs font-bold uppercase tracking-wider mb-2">
              <Clock class="w-3.5 h-3.5" />
              Active Sprints
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-text-base heading-font">Currently in Flight</h2>
            <p class="text-sm text-text-muted mt-1 max-w-2xl">
              Our active focus areas delivering cutting-edge Kubernetes platform enhancements, automated CVE tracking,
              and specialized data runtimes.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary-dark dark:text-primary-light text-xs font-bold shrink-0">
            Active Development
          </span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {activeInitiatives.map((item) => {
            const Icon = item.icon;
            return (
              <div class="glass-panel rounded-3xl p-6 border border-border/80 hover:border-primary/40 transition-all flex flex-col justify-between shadow-sm">
                <div>
                  <div class="flex items-center justify-between gap-3 mb-4">
                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary-light border border-primary/20">
                      <Icon class="w-5 h-5" />
                    </div>
                    <span
                      class={`inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold border ${item.badgeClass}`}
                    >
                      <span class="w-1.5 h-1.5 rounded-full bg-primary-light animate-pulse"></span>
                      {item.status}
                    </span>
                  </div>

                  <h3 class="text-base font-bold text-text-base heading-font mb-2">{item.title}</h3>
                  <p class="text-xs text-text-muted leading-relaxed mb-6">{item.description}</p>

                  <ul class="space-y-2.5 border-t border-border/60 pt-4">
                    {item.items.map((sub) => (
                      <li class="flex items-start gap-2 text-xs text-text-muted">
                        <div class="w-1.5 h-1.5 rounded-full bg-primary-light shrink-0 mt-1.5"></div>
                        <span class="leading-relaxed">{sub.text}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <!-- SECTION 3: STRATEGIC VISION (PLANNED) -->
      <section id="planned" class="mt-24 scroll-mt-24">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 pb-4 border-b border-border/80">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 dark:bg-orange-500/10 border border-orange-200 dark:border-orange-500/20 text-orange-900 dark:text-orange-300 text-xs font-bold uppercase tracking-wider mb-2">
              <Sparkles class="w-3.5 h-3.5" />
              Strategic Vision
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-text-base heading-font">Future Roadmap Initiatives</h2>
