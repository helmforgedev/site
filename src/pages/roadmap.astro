                      <li class="flex items-start gap-2.5 text-xs sm:text-sm text-text-muted">
                        <div class="w-1.5 h-1.5 rounded-full bg-accent-light shrink-0 mt-2"></div>
                        <span class="leading-relaxed">{sub.text}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <!-- GITHUB MILESTONES (DYNAMIC IF PRESENT) -->
      {milestones.length > 0 && (
        <section class="mt-24">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-xl font-bold text-text-base heading-font">Live GitHub Milestones</h3>
            <span class="text-xs text-text-muted">Directly synced from helmforgedev/charts</span>
          </div>

          {openMilestones.length > 0 && (
            <div class="space-y-4 mb-8">
              <h4 class="text-xs font-bold uppercase tracking-[0.16em] text-text-muted">Active GitHub Sprints</h4>
              {openMilestones.map((m) => (
                <a
                  href={m.html_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block glass-panel rounded-2xl p-5 transition-all hover:border-primary/40 hover:-translate-y-0.5"
                >
                  <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0 flex-1">
                      <div class="text-base font-bold text-text-base">{m.title}</div>
                      {m.description && <p class="mt-1 text-sm text-text-muted line-clamp-2">{m.description}</p>}
                    </div>
                    <span class="shrink-0 text-xs text-text-muted">{formatDate(m.due_on)}</span>
                  </div>
                  <div class="mt-3">
                    <div class="flex items-center justify-between text-xs text-text-muted mb-1.5">
                      <span>
                        {m.closed_issues}/{m.open_issues + m.closed_issues} issues
                      </span>
                      <span>{progress(m)}%</span>
                    </div>
                    <div class="h-1.5 rounded-full bg-border overflow-hidden">
                      <div class="h-full rounded-full bg-primary transition-all" style={`width: ${progress(m)}%`} />
                    </div>
                  </div>
                </a>
              ))}
            </div>
          )}

          {closedMilestones.length > 0 && (
            <div class="space-y-3">
              <h4 class="text-xs font-bold uppercase tracking-[0.16em] text-text-muted">Completed GitHub Milestones</h4>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                {closedMilestones.map((m) => (
                  <a
                    href={m.html_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-3 glass-panel rounded-xl px-4 py-3 transition-all hover:border-primary/40 opacity-80 hover:opacity-100"
                  >
                    <CheckCircle2 class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" />
                    <span class="text-xs font-semibold text-text-base truncate">{m.title}</span>
                    <span class="text-[11px] text-text-muted ml-auto shrink-0">{formatDate(m.due_on)}</span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </section>
      )}

      <!-- COMMUNITY CONTRIBUTION CTA -->
      <div class="mt-24 rounded-3xl border border-border/90 bg-gradient-to-b from-bg-surface to-bg-base p-8 sm:p-12 text-center relative overflow-hidden shadow-2xl">
        <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 dark:bg-orange-500/10 border border-orange-200 dark:border-orange-500/20 text-orange-900 dark:text-orange-300 text-xs font-bold uppercase tracking-wider mb-4">
          <Sparkles class="w-3.5 h-3.5" />
          Shape the Direction
        </div>

        <h3 class="text-2xl sm:text-3xl font-extrabold text-text-base heading-font">
          Have an architecture or chart suggestion?
        </h3>
        <p class="mt-3 text-sm sm:text-base text-text-muted max-w-xl mx-auto leading-relaxed">
          The HelmForge roadmap is defined by practicing platform engineers and open-source teams. Submit a chart
          request, share feedback, or propose an architectural pattern.
        </p>

        <div class="mt-8 flex flex-wrap justify-center items-center gap-4">
          <a
            href="/request"
            class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-primary to-accent px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-primary/20 hover:opacity-95 hover:shadow-primary/30 transition-all cursor-pointer"
          >
            Request a Chart
            <ArrowRight class="w-4 h-4" />
          </a>
          <a
            href="https://github.com/helmforgedev/charts/discussions"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-border bg-bg-surface px-6 py-3.5 text-sm font-bold text-text-base hover:border-primary/40 hover:bg-bg-base transition-all"
          >
            GitHub Discussions
            <ExternalLink class="w-4 h-4 opacity-60" />
          </a>
          <a
            href="https://github.com/helmforgedev/charts/issues"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-border bg-bg-surface px-6 py-3.5 text-sm font-bold text-text-base hover:border-primary/40 hover:bg-bg-base transition-all"
          >
            Open an Issue
            <ExternalLink class="w-4 h-4 opacity-60" />
          </a>
        </div>
      </div>
    </Container>
  </main>

  <Footer />
</BaseLayout>
