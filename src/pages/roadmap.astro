---

<BaseLayout
  title="Roadmap"
  description="Explore what we've delivered and where HelmForge is heading. Community-driven, production-tested Kubernetes Helm charts."
>
  <Header />

  <main id="main-content" class="py-16 sm:py-24" data-pagefind-body>
    <Container>
      <!-- Page Header -->
      <SectionHeader
        as="h1"
        label="Public Roadmap"
        title={
          'Forging the Future of <span class="bg-gradient-to-r from-primary-light via-accent to-accent-light bg-clip-text text-transparent">Kubernetes Packaging</span>'
        }
        description="Our roadmap is 100% public and community-driven. Track our extensive history of delivered capabilities, see what's currently in flight, and help guide our upcoming initiatives."
      />

      <!-- Impact Metrics Bar -->
      <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
        <div class="glass-panel rounded-2xl p-5 sm:p-6 border border-border/80 text-center">
          <div class="text-3xl sm:text-4xl font-extrabold text-primary dark:text-primary-light heading-font">136+</div>
          <p class="text-xs sm:text-sm font-semibold text-text-base mt-1.5">Production Charts Shipped</p>
          <p class="text-[11px] text-text-muted mt-0.5">100% Apache-2.0 & OSS</p>
        </div>

        <div class="glass-panel rounded-2xl p-5 sm:p-6 border border-border/80 text-center">
          <div class="text-3xl sm:text-4xl font-extrabold text-emerald-600 dark:text-emerald-400 heading-font">
            100%
          </div>
          <p class="text-xs sm:text-sm font-semibold text-text-base mt-1.5">Pinned Upstream Digests</p>
          <p class="text-[11px] text-text-muted mt-0.5">Zero Bitnami & Non-Root</p>
        </div>

        <div class="glass-panel rounded-2xl p-5 sm:p-6 border border-border/80 text-center">
          <div class="text-3xl sm:text-4xl font-extrabold text-accent dark:text-accent-light heading-font">
            20-Layer
          </div>
          <p class="text-xs sm:text-sm font-semibold text-text-base mt-1.5">Automated Validation Gate</p>
          <p class="text-[11px] text-text-muted mt-0.5">k3d, unittests & kubeconform</p>
        </div>

        <div class="glass-panel rounded-2xl p-5 sm:p-6 border border-border/80 text-center">
          <div class="text-3xl sm:text-4xl font-extrabold text-text-base heading-font">0</div>
          <p class="text-xs sm:text-sm font-semibold text-text-base mt-1.5">Unresolved Requests</p>
          <p class="text-[11px] text-text-muted mt-0.5">100% Community Requests Built</p>
        </div>
      </div>

      <!-- Quick Nav Jump Bar -->
      <div class="mt-12 flex flex-wrap items-center justify-center gap-3">
        <a
          href="#delivered"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 text-xs font-bold hover:bg-emerald-500/20 transition-all"
        >
          <BadgeCheck class="w-4 h-4" />
          Completed Deliveries ({deliveredPillars.length} Pillars)
        </a>
        <a
          href="#active"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-primary/30 bg-primary/10 text-primary-dark dark:text-primary-light text-xs font-bold hover:bg-primary/20 transition-all"
        >
          <Clock class="w-4 h-4" />
          In Progress ({activeInitiatives.length} Tracks)
        </a>
        <a
          href="#planned"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-orange-200 dark:border-orange-500/30 bg-orange-50 dark:bg-orange-500/10 text-orange-900 dark:text-orange-300 text-xs font-bold hover:bg-orange-100 dark:hover:bg-orange-500/20 transition-all"
        >
          <Sparkles class="w-4 h-4" />
          Strategic Vision ({plannedInitiatives.length} Initiatives)
        </a>
      </div>

      <!-- SECTION 1: DELIVERED CAPABILITIES (COMPLETED) -->
      <section id="delivered" class="mt-20 scroll-mt-24">
