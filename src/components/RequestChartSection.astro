---
import { GitPullRequest, ArrowRight, ThumbsUp, Sparkles } from 'lucide-astro';
import Container from './Container.astro';
---

<section class="relative overflow-hidden border-t border-border bg-bg-surface/40 py-20 sm:py-24">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/10 via-transparent to-transparent pointer-events-none"></div>

  <Container class="relative">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary-light text-xs font-bold tracking-wider uppercase mb-6 backdrop-blur-sm">
          <Sparkles class="w-3.5 h-3.5" />
          Community Driven Roadmap
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight heading-font text-text-base leading-tight">
          Missing a chart for your stack?
          <span class="block bg-gradient-to-r from-primary-light to-accent bg-clip-text text-transparent">
            Request it. We forge it.
          </span>
        </h2>

        <p class="mt-6 text-base sm:text-lg text-text-muted leading-relaxed max-w-xl mx-auto lg:mx-0">
          HelmForge is built for and shaped by the Kubernetes community. Vote on upcoming applications or submit a
          request with zero friction. The most requested charts move straight to active development.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
          <a
            href="/request"
            class="glow-effect inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-2xl bg-primary px-7 py-3.5 text-base font-bold text-white transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-primary/30"
          >
            <GitPullRequest class="w-5 h-5" />
            Request a Chart
            <ArrowRight class="w-4 h-4" />
          </a>

          <a
            href="https://github.com/helmforgedev/charts/issues?q=is%3Aissue+is%3Aopen+label%3Achart-request"
            target="_blank"
            rel="noopener noreferrer"
            class="glass-panel inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-2xl px-7 py-3.5 text-base font-bold text-text-base transition-all hover:bg-text-base/10 hover:-translate-y-0.5"
          >
            <ThumbsUp class="w-4 h-4 text-primary-light" />
            Upvote on GitHub
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="glass-panel rounded-3xl p-6 sm:p-8 border border-border/80 shadow-2xl relative">
          <div class="flex items-center justify-between border-b border-border/60 pb-4 mb-5">
            <span class="text-xs font-bold uppercase tracking-wider text-text-muted">How Community Charts Work</span>
            <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-primary/10 text-primary-light border border-primary/20">
              100% Open-Source
            </span>
          </div>

          <ul class="space-y-4 text-sm text-text-muted">
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center text-primary-light text-xs font-bold shrink-0 mt-0.5">
                1
              </div>
              <span>
                <strong class="text-text-base">Community Request:</strong> Submit an issue or vote on existing chart
                candidates.
              </span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center text-primary-light text-xs font-bold shrink-0 mt-0.5">
                2
              </div>
              <span>
                <strong class="text-text-base">Hardened Standards:</strong> Official upstream images, UID 1000 non-root,
                S3 backup and Gateway API.
              </span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center text-primary-light text-xs font-bold shrink-0 mt-0.5">
                3
              </div>
              <span>
                <strong class="text-text-base">Automated Assurance:</strong> Dual-stack k3d validation, Trivy/Kubescape
                scans, and Cosign OCI signatures.
              </span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </Container>
</section>
