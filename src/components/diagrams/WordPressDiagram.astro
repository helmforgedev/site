---
interface Props {
  mode: 'production' | 'cache';
}

const { mode } = Astro.props;
---

<svg
  viewBox="0 0 760 340"
  class="w-full max-w-[760px] h-auto"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`WordPress ${mode} architecture diagram`}
>
  <style>
    .diagram-text {
      font-family: ui-monospace, monospace;
      font-size: 11px;
    }
    .diagram-label {
      font-family: ui-sans-serif, system-ui, sans-serif;
      font-size: 10px;
    }
    .muted {
      opacity: 0.55;
    }
  </style>

  {
    mode === 'production' ? (
      <g>
        <rect x="20" y="42" width="96" height="46" rx="8" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text x="68" y="61" text-anchor="middle" fill="currentColor" class="diagram-text">
          Users
        </text>
        <text x="68" y="75" text-anchor="middle" fill="currentColor" class="diagram-label muted">
          HTTPS
        </text>

        <line x1="116" y1="65" x2="164" y2="65" stroke="currentColor" stroke-width="1.5" />
        <polygon points="164,60 174,65 164,70" fill="currentColor" />

        <rect
          x="174"
          y="34"
          width="134"
          height="62"
          rx="8"
          fill="currentColor"
          fill-opacity="0.04"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-dasharray="6 3"
        />
        <text x="241" y="58" text-anchor="middle" fill="currentColor" class="diagram-text">
          Gateway API
        </text>
        <text x="241" y="73" text-anchor="middle" fill="currentColor" class="diagram-label muted">
          or Ingress
        </text>

        <line x1="308" y1="65" x2="360" y2="65" stroke="currentColor" stroke-width="1.5" />
        <polygon points="360,60 370,65 360,70" fill="currentColor" />

        <rect
          x="370"
          y="34"
          width="132"
          height="62"
          rx="8"
          fill="currentColor"
          fill-opacity="0.06"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <text x="436" y="58" text-anchor="middle" fill="currentColor" class="diagram-text">
          Service
        </text>
        <text x="436" y="73" text-anchor="middle" fill="currentColor" class="diagram-label muted">
          dual-stack optional
        </text>

        <line x1="502" y1="65" x2="552" y2="65" stroke="currentColor" stroke-width="1.5" />
        <polygon points="552,60 562,65 552,70" fill="currentColor" />

        <rect
          x="562"
          y="24"
          width="160"
          height="84"
          rx="10"
          fill="currentColor"
          fill-opacity="0.08"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <text x="642" y="51" text-anchor="middle" fill="currentColor" class="diagram-text" font-weight="bold">
          WordPress
        </text>
        <text x="642" y="66" text-anchor="middle" fill="currentColor" class="diagram-label muted">
          official apache image
        </text>
        <text x="642" y="81" text-anchor="middle" fill="currentColor" class="diagram-label muted">
          HPA / PDB optional
        </text>

        <rect x="370" y="150" width="132" height="58" rx="8" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text x="436" y="173" text-anchor="middle" fill="currentColor" class="diagram-text">
          PVC
        </text>
        <text x="436" y="188" text-anchor="middle" fill="currentColor" class="diagram-label muted">
          /var/www/html
        </text>

        <line x1="562" y1="94" x2="502" y2="160" stroke="currentColor" stroke-width="1.3" stroke-dasharray="4 3" />
        <polygon points="510,156 502,160 503,151" fill="currentColor" />

        <rect x="562" y="150" width="160" height="58" rx="8" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text x="642" y="173" text-anchor="middle" fill="currentColor" class="diagram-text">
          MySQL / MariaDB
        </text>
        <text x="642" y="188" text-anchor="middle" fill="currentColor" class="diagram-label muted">
          subchart or external
        </text>

        <line x1="642" y1="108" x2="642" y2="150" stroke="currentColor" stroke-width="1.5" />
        <polygon points="637,140 642,150 647,140" fill="currentColor" />

        <rect
          x="174"
          y="150"
          width="134"
          height="58"
          rx="8"
          fill="currentColor"
          fill-opacity="0.04"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-dasharray="6 3"
        />
        <text x="241" y="173" text-anchor="middle" fill="currentColor" class="diagram-text">
          ExternalSecret
        </text>
        <text x="241" y="188" text-anchor="middle" fill="currentColor" class="diagram-label muted">
          optional
        </text>

        <line x1="308" y1="179" x2="370" y2="179" stroke="currentColor" stroke-width="1.2" stroke-dasharray="4 3" />
        <polygon points="360,174 370,179 360,184" fill="currentColor" />

        <rect
          x="370"
          y="258"
          width="132"
          height="52"
          rx="8"
          fill="currentColor"
          fill-opacity="0.04"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-dasharray="6 3"
        />
        <text x="436" y="279" text-anchor="middle" fill="currentColor" class="diagram-text">
          Backup CronJob
        </text>
        <text x="436" y="294" text-anchor="middle" fill="currentColor" class="diagram-label muted">
          DB + wp-content
        </text>

        <line x1="502" y1="198" x2="436" y2="258" stroke="currentColor" stroke-width="1.2" stroke-dasharray="4 3" />
        <polygon points="444,254 436,258 438,249" fill="currentColor" />

        <rect x="562" y="258" width="160" height="52" rx="8" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text x="642" y="279" text-anchor="middle" fill="currentColor" class="diagram-text">
          S3 bucket
        </text>
        <text x="642" y="294" text-anchor="middle" fill="currentColor" class="diagram-label muted">
          compatible storage
        </text>

        <line x1="502" y1="284" x2="562" y2="284" stroke="currentColor" stroke-width="1.5" />
        <polygon points="552,279 562,284 552,289" fill="currentColor" />
      </g>
    ) : (
      <g>
        <rect
          x="24"
          y="52"
          width="152"
          height="66"
          rx="10"
          fill="currentColor"
          fill-opacity="0.08"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <text x="100" y="78" text-anchor="middle" fill="currentColor" class="diagram-text" font-weight="bold">
          WordPress pod
        </text>
        <text x="100" y="94" text-anchor="middle" fill="currentColor" class="diagram-label muted">
          wp-config.php constants
        </text>

        <line x1="176" y1="85" x2="246" y2="85" stroke="currentColor" stroke-width="1.5" />
        <polygon points="246,80 256,85 246,90" fill="currentColor" />

        <rect x="256" y="52" width="150" height="66" rx="10" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text x="331" y="78" text-anchor="middle" fill="currentColor" class="diagram-text">
          Redis Object Cache
        </text>
        <text x="331" y="94" text-anchor="middle" fill="currentColor" class="diagram-label muted">
          plugin + drop-in
        </text>

        <line x1="406" y1="85" x2="476" y2="85" stroke="currentColor" stroke-width="1.5" />
        <polygon points="476,80 486,85 476,90" fill="currentColor" />

        <rect
          x="486"
          y="52"
          width="150"
          height="66"
          rx="10"
          fill="currentColor"
          fill-opacity="0.05"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <text x="561" y="78" text-anchor="middle" fill="currentColor" class="diagram-text">
          Redis
        </text>
        <text x="561" y="94" text-anchor="middle" fill="currentColor" class="diagram-label muted">
          subchart or external
        </text>

        <rect x="256" y="170" width="150" height="72" rx="10" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text x="331" y="196" text-anchor="middle" fill="currentColor" class="diagram-text">
          Plugin Job
        </text>
        <text x="331" y="212" text-anchor="middle" fill="currentColor" class="diagram-label muted">
          post-install/upgrade
        </text>
        <text x="331" y="226" text-anchor="middle" fill="currentColor" class="diagram-label muted">
          requires PVC
        </text>

        <line x1="331" y1="170" x2="331" y2="118" stroke="currentColor" stroke-width="1.3" stroke-dasharray="4 3" />
        <polygon points="326,128 331,118 336,128" fill="currentColor" />

        <rect x="24" y="170" width="152" height="72" rx="10" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text x="100" y="196" text-anchor="middle" fill="currentColor" class="diagram-text">
          Shared PVC
        </text>
        <text x="100" y="212" text-anchor="middle" fill="currentColor" class="diagram-label muted">
          wp-content/plugins
        </text>
        <text x="100" y="226" text-anchor="middle" fill="currentColor" class="diagram-label muted">
          object-cache.php
        </text>

        <line x1="176" y1="206" x2="256" y2="206" stroke="currentColor" stroke-width="1.5" />
        <polygon points="246,201 256,206 246,211" fill="currentColor" />

        <rect
          x="486"
          y="170"
          width="150"
          height="72"
          rx="10"
          fill="currentColor"
          fill-opacity="0.04"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-dasharray="6 3"
        />
        <text x="561" y="196" text-anchor="middle" fill="currentColor" class="diagram-text">
          Secret
        </text>
        <text x="561" y="212" text-anchor="middle" fill="currentColor" class="diagram-label muted">
          optional password
        </text>
        <text x="561" y="226" text-anchor="middle" fill="currentColor" class="diagram-label muted">
          skipped when auth off
        </text>

        <line x1="561" y1="170" x2="561" y2="118" stroke="currentColor" stroke-width="1.3" stroke-dasharray="4 3" />
        <polygon points="556,128 561,118 566,128" fill="currentColor" />
      </g>
    )
  }
</svg>
