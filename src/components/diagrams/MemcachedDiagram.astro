---
interface Props {
  mode: 'standalone' | 'distributed';
}

const { mode } = Astro.props;
---

<svg
  viewBox="0 0 720 300"
  class="w-full max-w-[720px] h-auto"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`Memcached ${mode} architecture diagram`}
>
  <style>
    .diagram-text {
      font-family: ui-monospace, monospace;
      font-size: 12px;
    }
    .diagram-label {
      font-family: ui-sans-serif, system-ui, sans-serif;
      font-size: 10px;
    }
  </style>

  {
    mode === 'standalone' ? (
      <g>
        <rect x="24" y="92" width="130" height="58" rx="8" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text x="89" y="116" text-anchor="middle" fill="currentColor" class="diagram-text">
          Application
        </text>
        <text x="89" y="132" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          cache client
        </text>

        <line x1="154" y1="121" x2="232" y2="121" stroke="currentColor" stroke-width="1.5" />
        <polygon points="232,116 242,121 232,126" fill="currentColor" />
        <text x="195" y="112" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          TCP 11211
        </text>

        <rect
          x="242"
          y="72"
          width="168"
          height="98"
          rx="10"
          fill="currentColor"
          fill-opacity="0.06"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <text x="326" y="102" text-anchor="middle" fill="currentColor" class="diagram-text" font-weight="bold">
          Memcached
        </text>
        <text x="326" y="119" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.6">
          StatefulSet pod-0
        </text>
        <text x="326" y="136" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.6">
          volatile RAM cache
        </text>
        <text x="326" y="153" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.6">
          optional TLS/auth
        </text>

        <line x1="410" y1="121" x2="495" y2="121" stroke="currentColor" stroke-width="1.5" stroke-dasharray="5 4" />
        <polygon points="495,116 505,121 495,126" fill="currentColor" />
        <rect
          x="505"
          y="84"
          width="160"
          height="74"
          rx="8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-dasharray="6 3"
        />
        <text x="585" y="111" text-anchor="middle" fill="currentColor" class="diagram-text">
          Metrics
        </text>
        <text x="585" y="128" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          exporter sidecar
        </text>
        <text x="585" y="144" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          optional
        </text>

        <line x1="326" y1="170" x2="326" y2="213" stroke="currentColor" stroke-width="1.5" stroke-dasharray="5 4" />
        <rect x="248" y="213" width="156" height="46" rx="8" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text x="326" y="234" text-anchor="middle" fill="currentColor" class="diagram-label">
          optional extstore
        </text>
        <text x="326" y="249" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          cache extension
        </text>
      </g>
    ) : (
      <g>
        <rect x="20" y="106" width="126" height="58" rx="8" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text x="83" y="130" text-anchor="middle" fill="currentColor" class="diagram-text">
          App Clients
        </text>
        <text x="83" y="146" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          consistent hashing
        </text>

        <line x1="146" y1="135" x2="220" y2="135" stroke="currentColor" stroke-width="1.5" />
        <polygon points="220,130 230,135 220,140" fill="currentColor" />

        <rect
          x="230"
          y="98"
          width="132"
          height="74"
          rx="10"
          fill="currentColor"
          fill-opacity="0.05"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <text x="296" y="124" text-anchor="middle" fill="currentColor" class="diagram-text" font-weight="bold">
          Service
        </text>
        <text x="296" y="141" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.6">
          ClusterIP/LB
        </text>
        <text x="296" y="157" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.6">
          dual-stack optional
        </text>

        <line x1="362" y1="135" x2="430" y2="68" stroke="currentColor" stroke-width="1.2" />
        <line x1="362" y1="135" x2="430" y2="135" stroke="currentColor" stroke-width="1.2" />
        <line x1="362" y1="135" x2="430" y2="202" stroke="currentColor" stroke-width="1.2" />

        <rect
          x="430"
          y="38"
          width="156"
          height="60"
          rx="8"
          fill="currentColor"
          fill-opacity="0.08"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <text x="508" y="62" text-anchor="middle" fill="currentColor" class="diagram-text" font-weight="bold">
          pod-0
        </text>
        <text x="508" y="79" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          independent cache
        </text>

        <rect
          x="430"
          y="105"
          width="156"
          height="60"
          rx="8"
          fill="currentColor"
          fill-opacity="0.08"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <text x="508" y="129" text-anchor="middle" fill="currentColor" class="diagram-text" font-weight="bold">
          pod-1
        </text>
        <text x="508" y="146" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          no replication
        </text>

        <rect
          x="430"
          y="172"
          width="156"
          height="60"
          rx="8"
          fill="currentColor"
          fill-opacity="0.08"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <text x="508" y="196" text-anchor="middle" fill="currentColor" class="diagram-text" font-weight="bold">
          pod-2
        </text>
        <text x="508" y="213" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          stable DNS
        </text>

        <rect
          x="600"
          y="84"
          width="98"
          height="102"
          rx="8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-dasharray="6 3"
        />
        <text x="649" y="111" text-anchor="middle" fill="currentColor" class="diagram-label">
          TLS/auth
        </text>
        <text x="649" y="129" text-anchor="middle" fill="currentColor" class="diagram-label">
          metrics
        </text>
        <text x="649" y="147" text-anchor="middle" fill="currentColor" class="diagram-label">
          HPA/PDB
        </text>
        <text x="649" y="165" text-anchor="middle" fill="currentColor" class="diagram-label">
          NetworkPolicy
        </text>
      </g>
    )
  }
</svg>
