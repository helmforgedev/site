---
interface Props {
  mode: 'production' | 'secrets';
}

const { mode } = Astro.props;
---

<svg
  viewBox="0 0 720 300"
  class="w-full max-w-[720px] h-auto"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`phpMyAdmin ${mode} architecture diagram`}
>
  <style>
    .diagram-text {
      font-family: ui-monospace, monospace;
      font-size: 11px;
    }
    .diagram-label {
      font-family: ui-sans-serif, system-ui, sans-serif;
      font-size: 10px;
    }
  </style>

  {
    mode === 'production' ? (
      <g>
        <rect x="20" y="70" width="115" height="50" rx="8" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text x="77" y="92" text-anchor="middle" fill="currentColor" class="diagram-text">
          Admin user
        </text>
        <text x="77" y="106" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          VPN / SSO / allowlist
        </text>

        <line x1="135" y1="95" x2="205" y2="95" stroke="currentColor" stroke-width="1.5" />
        <polygon points="205,90 215,95 205,100" fill="currentColor" />
        <rect x="215" y="62" width="140" height="66" rx="10" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text x="285" y="86" text-anchor="middle" fill="currentColor" class="diagram-text">
          Ingress / Gateway
        </text>
        <text x="285" y="101" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          TLS terminates here
        </text>
        <text x="285" y="115" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          HTTPRoute or Ingress
        </text>

        <line x1="355" y1="95" x2="420" y2="95" stroke="currentColor" stroke-width="1.5" />
        <polygon points="420,90 430,95 420,100" fill="currentColor" />
        <rect
          x="430"
          y="55"
          width="145"
          height="80"
          rx="10"
          fill="currentColor"
          fill-opacity="0.07"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <text x="502" y="80" text-anchor="middle" fill="currentColor" class="diagram-text" font-weight="bold">
          phpMyAdmin pods
        </text>
        <text x="502" y="95" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          Deployment + Service
        </text>
        <text x="502" y="110" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          optional HPA / PDB
        </text>

        <line x1="575" y1="95" x2="640" y2="95" stroke="currentColor" stroke-width="1.5" />
        <polygon points="640,90 650,95 640,100" fill="currentColor" />
        <rect x="650" y="65" width="55" height="60" rx="8" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text x="677" y="91" text-anchor="middle" fill="currentColor" class="diagram-text">
          MySQL
        </text>
        <text x="677" y="106" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          3306
        </text>

        <line x1="502" y1="135" x2="502" y2="180" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3" />
        <rect x="425" y="180" width="155" height="46" rx="8" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text x="502" y="199" text-anchor="middle" fill="currentColor" class="diagram-text">
          /sessions
        </text>
        <text x="502" y="213" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          emptyDir or PVC
        </text>

        <rect x="215" y="180" width="145" height="46" rx="8" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text x="287" y="199" text-anchor="middle" fill="currentColor" class="diagram-text">
          NetworkPolicy
        </text>
        <text x="287" y="213" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          ingress + DB egress
        </text>
        <line x1="430" y1="120" x2="355" y2="180" stroke="currentColor" stroke-width="1" stroke-dasharray="4 3" />
      </g>
    ) : (
      <g>
        <rect x="20" y="60" width="145" height="58" rx="8" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text x="92" y="85" text-anchor="middle" fill="currentColor" class="diagram-text">
          Secret backend
        </text>
        <text x="92" y="100" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          Vault / cloud / GitOps
        </text>

        <line x1="165" y1="89" x2="240" y2="89" stroke="currentColor" stroke-width="1.5" />
        <polygon points="240,84 250,89 240,94" fill="currentColor" />
        <rect
          x="250"
          y="50"
          width="150"
          height="78"
          rx="10"
          fill="currentColor"
          fill-opacity="0.06"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <text x="325" y="77" text-anchor="middle" fill="currentColor" class="diagram-text" font-weight="bold">
          ExternalSecret
        </text>
        <text x="325" y="93" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          external-secrets.io/v1
        </text>
        <text x="325" y="108" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          optional
        </text>

        <line x1="400" y1="89" x2="470" y2="89" stroke="currentColor" stroke-width="1.5" />
        <polygon points="470,84 480,89 470,94" fill="currentColor" />
        <rect x="480" y="60" width="120" height="58" rx="8" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text x="540" y="85" text-anchor="middle" fill="currentColor" class="diagram-text">
          Secret
        </text>
        <text x="540" y="100" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          auth + blowfish
        </text>

        <line x1="540" y1="118" x2="540" y2="170" stroke="currentColor" stroke-width="1.5" />
        <polygon points="535,170 540,180 545,170" fill="currentColor" />
        <rect
          x="455"
          y="180"
          width="170"
          height="70"
          rx="10"
          fill="currentColor"
          fill-opacity="0.07"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <text x="540" y="205" text-anchor="middle" fill="currentColor" class="diagram-text" font-weight="bold">
          phpMyAdmin pod
        </text>
        <text x="540" y="220" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          HELMFORGE_BLOWFISH_SECRET
        </text>
        <text x="540" y="235" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          generated config.user.inc.php
        </text>

        <rect x="215" y="180" width="150" height="70" rx="10" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text x="290" y="205" text-anchor="middle" fill="currentColor" class="diagram-text">
          existing Secret
        </text>
        <text x="290" y="220" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          alternative path
        </text>
        <text x="290" y="235" text-anchor="middle" fill="currentColor" class="diagram-label" opacity="0.55">
          no ESO required
        </text>
        <line x1="365" y1="215" x2="455" y2="215" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3" />
      </g>
    )
  }
</svg>
