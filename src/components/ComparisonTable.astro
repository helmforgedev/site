---
import { CheckCircle2, ChevronRight, Scale } from 'lucide-astro';
import Container from './Container.astro';
import { comparisonFull } from '../data/comparison';
---

<section class="bg-bg-base py-20 lg:py-28 relative border-t border-border/50">
  <!-- Subtle Gradient Background -->
  <div class="absolute inset-0 bg-gradient-to-b from-bg-surface/30 to-bg-base pointer-events-none"></div>

  <Container class="relative">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center justify-center p-3 rounded-2xl bg-primary/10 text-primary mb-6 ring-1 ring-primary/20">
        <Scale class="w-6 h-6" />
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-text-base heading-font">
        HelmForge vs Bitnami — feature by feature.
      </h2>
      <p class="mt-5 text-lg text-text-muted leading-relaxed">
        Official upstream images, Apache-2.0 licensed, zero vendor lock-in. See exactly why teams switch from Bitnami to
        HelmForge.
      </p>
    </div>

    <div class="comparison-wrapper overflow-hidden rounded-3xl border border-border bg-bg-surface/50 backdrop-blur-md shadow-2xl shadow-black/40">
      <div class="overflow-x-auto scrollbar-hide">
        <table class="w-full text-sm text-left border-collapse">
          <caption class="sr-only">Feature comparison between HelmForge, Bitnami, and generic community charts</caption>
          <thead>
            <tr class="border-b border-border bg-bg-surface/90">
              <th scope="col" class="px-6 py-5 font-bold text-text-muted w-[22%] uppercase tracking-wider text-xs">
                Features
              </th>
              <th scope="col" class="px-6 py-5 w-[34%] bg-primary/10 border-x border-primary/20">
                <div class="flex items-center justify-between">
                  <span class="flex items-center gap-2 font-black text-primary-light text-base heading-font">
                    <CheckCircle2 class="w-5 h-5 text-emerald-400" />
                    HelmForge
                  </span>
                  <span class="hidden sm:inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-primary text-white">
                    100% OSS
                  </span>
                </div>
              </th>
              <th scope="col" class="px-6 py-5 font-bold text-text-muted w-[22%] text-xs uppercase tracking-wider">
                Bitnami
              </th>
              <th scope="col" class="px-6 py-5 font-bold text-text-muted w-[22%] text-xs uppercase tracking-wider">
                Generic Community
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/60">
            {comparisonFull.map((row) => (
              <tr
                class={`comparison-row group transition-colors hover:bg-white/[0.02] ${row.highlight ? 'bg-primary/[0.015]' : ''}`}
              >
                <th scope="row" class="px-6 py-4 font-semibold text-text-base whitespace-nowrap text-left">
                  {row.aspect}
                </th>
                <td class="px-6 py-4 text-text-base font-semibold bg-primary/[0.04] border-x border-primary/20 group-hover:bg-primary/[0.07] transition-colors">
                  <span class="flex items-start gap-2.5">
                    <CheckCircle2 class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" />
                    <span class="text-text-base">{row.helmforge}</span>
                  </span>
                </td>
                <td class="px-6 py-4 text-text-muted leading-relaxed">{row.bitnami}</td>
                <td class="px-6 py-4 text-text-muted leading-relaxed">{row.community}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-10 flex justify-center">
      <a
        href="/docs/comparison"
        class="group inline-flex items-center gap-2 rounded-full border border-border bg-bg-surface px-6 py-3 text-sm font-semibold text-text-base transition-all hover:border-primary/50 hover:text-primary-light hover:shadow-lg hover:shadow-primary/10"
      >
        Read the full comparison
        <ChevronRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </Container>
</section>
