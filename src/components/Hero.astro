---
// SPDX-License-Identifier: Apache-2.0
import { Terminal, Database, Github, Sparkles, Sliders, ShieldCheck, ArrowRight, Copy } from 'lucide-astro';
import Container from './Container.astro';
import { chartCount, stableCount, backupCount } from '../data/charts';
---

<section class="relative overflow-hidden py-20 sm:py-28 lg:pb-36 lg:pt-32">
  <!-- Subtle Grid Background -->
  <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PHBhdGggZD0iTTAgMGgyNHYyNEgwem0xIDF2MjJoMjJWMXoiIGZpbGw9InJnYmEoMjU1LDI1NSwyNTUsMC4wMSkiIGZpbGwtcnVsZT0iZXZlbm9kZCIvPjwvc3ZnPg==')] [mask-image:linear-gradient(to_bottom,white,transparent)]"></div>

  <!-- Animated Mesh Gradients -->
  <div class="hero-mesh absolute top-0 right-0 -translate-y-12 translate-x-1/3 w-[800px] h-[600px] bg-primary/20 rounded-full blur-[140px] opacity-60 mix-blend-screen pointer-events-none"></div>
  <div class="hero-mesh absolute bottom-0 left-0 translate-y-1/3 -translate-x-1/3 w-[600px] h-[600px] bg-accent/20 rounded-full blur-[120px] opacity-50 mix-blend-screen pointer-events-none"></div>

  <Container class="relative grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
    <!-- Left Copy -->
    <div class="lg:col-span-6 flex flex-col justify-center text-center lg:text-left">
      <!-- Badge: Bitnami Alternative -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary-light text-xs font-bold tracking-wider uppercase w-fit mx-auto lg:mx-0 mb-6 backdrop-blur-sm shadow-sm">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-light opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
        </span>
        The Open-Source Bitnami Alternative
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1] heading-font text-text-base">
        Production Helm charts,{' '}
        <span class="bg-gradient-to-r from-primary-light via-accent-light to-accent bg-clip-text text-transparent">
          forged to last.
        </span>
      </h1>

      <p class="mt-5 text-base sm:text-lg text-text-muted leading-relaxed max-w-2xl mx-auto lg:mx-0">
        Free forever, Apache-2.0 licensed Kubernetes charts. Official upstream images, automated S3 backups, strict
        non-root security, and native Gateway API support. Zero vendor lock-in.
      </p>

      <!-- Key Action CTAs -->
      <div class="mt-8 flex flex-col sm:flex-row items-center gap-3.5 justify-center lg:justify-start">
        <a
          href="/charts"
          class="glow-effect group inline-flex w-full sm:w-auto items-center justify-center gap-2.5 rounded-xl bg-primary px-7 py-3.5 text-sm font-bold text-white transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-primary/30"
        >
          <Database class="w-4 h-4 transition-transform group-hover:scale-110" />
          Explore {chartCount}+ Charts
        </a>

        <a
          href="/playground"
          class="glass-panel group inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl px-6 py-3.5 text-sm font-bold text-text-base transition-all hover:bg-text-base/10 hover:-translate-y-0.5 hover:shadow-lg border border-border"
        >
          <Sliders class="w-4 h-4 text-primary-light transition-transform group-hover:rotate-45" />
          Values Studio
        </a>

        <a
          href="#chart-request"
          class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl px-5 py-3.5 text-sm font-semibold text-text-muted hover:text-text-base transition-colors"
        >
          <Sparkles class="w-4 h-4 text-accent-light" />
          Request a Chart
        </a>
      </div>

      <!-- Trust signals & stats bar -->
      <div class="mt-10 pt-8 border-t border-border/60 grid grid-cols-3 gap-4 text-center lg:text-left">
        <div>
          <p class="text-2xl sm:text-3xl font-extrabold text-text-base heading-font">{chartCount}+</p>
          <p class="text-xs uppercase tracking-wider text-text-muted mt-0.5">Production Charts</p>
        </div>
        <div>
          <p class="text-2xl sm:text-3xl font-extrabold text-primary-light heading-font">{stableCount}</p>
          <p class="text-xs uppercase tracking-wider text-text-muted mt-0.5">Stable Releases</p>
        </div>
        <div>
          <p class="text-2xl sm:text-3xl font-extrabold text-accent-light heading-font">{backupCount}</p>
          <p class="text-xs uppercase tracking-wider text-text-muted mt-0.5">With S3 Backup</p>
        </div>
      </div>

      <!-- Trust Badges -->
      <div class="mt-6 flex flex-wrap items-center gap-3 justify-center lg:justify-start text-xs text-text-muted">
        <a
          href="https://github.com/helmforgedev/charts"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full border border-border bg-bg-surface/50 px-3 py-1 transition-colors hover:border-primary/40 hover:text-text-base"
        >
          <Github class="w-3.5 h-3.5" />
          <span>Star on GitHub</span>
        </a>

        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-medium">
          <ShieldCheck class="w-3.5 h-3.5" />
          100% Apache-2.0
        </span>

        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-500/10 text-sky-400 border border-sky-500/20 font-medium">
          Cosign + GPG Signed
        </span>

        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 text-primary-light border border-primary/20 font-medium">
          Zero Vendor Lock-in
        </span>
      </div>
    </div>

    <!-- Right Quick-Install Terminal Mockup -->
    <div class="lg:col-span-6 w-full max-w-xl mx-auto lg:max-w-none relative">
      <div class="absolute -inset-2 rounded-[2rem] bg-gradient-to-br from-primary-light/30 via-accent/20 to-transparent opacity-60 blur-2xl"></div>

      <div class="hero-terminal relative rounded-2xl overflow-hidden shadow-2xl border border-white/10 bg-[#0d1117] backdrop-blur-2xl transition-all duration-500 ease-out hover:scale-[1.01]">
        <!-- macOS Style Header with tabs -->
        <div class="flex items-center justify-between px-4 py-3 border-b border-white/5 bg-[#161b22]">
          <div class="flex space-x-2">
            <div class="w-3 h-3 rounded-full bg-[#ff5f56] border border-[#e0443e]"></div>
            <div class="w-3 h-3 rounded-full bg-[#ffbd2e] border border-[#dea123]"></div>
            <div class="w-3 h-3 rounded-full bg-[#27c93f] border border-[#1aab29]"></div>
          </div>

          <div class="flex items-center gap-1.5 text-xs text-zinc-400 font-mono bg-[#0d1117] rounded-md px-3 py-1 border border-white/5">
            <Terminal class="w-3 h-3 text-emerald-400" />
            helm install — 3s quickstart
          </div>

          <div class="w-12"></div>
        </div>

        <!-- Interactive Quick Chart Picker -->
        <div class="px-4 py-2.5 bg-[#12161f] border-b border-white/5 flex items-center gap-1.5 overflow-x-auto scrollbar-none text-[11px] font-mono">
          <span class="text-zinc-400 select-none mr-1">App:</span>
          <button
            class="hero-app-tab px-2.5 py-1 rounded-md transition-colors bg-violet-600/30 text-violet-200 font-bold border border-violet-500/40"
            data-app="postgresql"
            data-repo="postgresql"
          >
            PostgreSQL
          </button>
          <button
            class="hero-app-tab px-2.5 py-1 rounded-md transition-colors text-zinc-300 hover:text-white hover:bg-white/5"
            data-app="redis"
            data-repo="redis"
          >
            Redis
          </button>
          <button
            class="hero-app-tab px-2.5 py-1 rounded-md transition-colors text-zinc-300 hover:text-white hover:bg-white/5"
            data-app="n8n"
            data-repo="n8n"
          >
            n8n
          </button>
          <button
            class="hero-app-tab px-2.5 py-1 rounded-md transition-colors text-zinc-300 hover:text-white hover:bg-white/5"
            data-app="keycloak"
            data-repo="keycloak"
          >
            Keycloak
          </button>
          <button
            class="hero-app-tab px-2.5 py-1 rounded-md transition-colors text-zinc-300 hover:text-white hover:bg-white/5"
            data-app="nextcloud"
            data-repo="nextcloud"
          >
            Nextcloud
          </button>
        </div>

        <!-- Terminal Body -->
        <div
          id="terminal-body"
          class="relative p-5 font-mono text-xs sm:text-[13px] leading-[1.7] min-h-[300px] overflow-y-auto text-zinc-200 scrollbar-none"
        >
          <!-- Scan-line overlay -->
          <div class="absolute inset-0 pointer-events-none opacity-[0.03] bg-[repeating-linear-gradient(0deg,transparent,transparent_1px,rgba(255,255,255,0.1)_1px,rgba(255,255,255,0.1)_2px)]"></div>

          <div id="terminal-lines" class="relative space-y-1">
            <div class="text-zinc-400 select-none"># 1. Add the official HelmForge repository</div>
            <div class="flex items-center justify-between group/line">
              <span class="text-emerald-400">
                user@k8s:~$ <span class="text-white">helm repo add helmforge https://repo.helmforge.dev</span>
              </span>
            </div>
            <div class="text-zinc-400 select-none"># 2. Update local chart cache</div>
            <div class="flex items-center justify-between group/line">
              <span class="text-emerald-400">
                user@k8s:~$ <span class="text-white">helm repo update</span>
              </span>
            </div>
            <div class="text-zinc-400 select-none pt-2"># 3. Deploy hardened, production-ready chart</div>
            <div class="p-3 rounded-lg bg-black/60 border border-white/10 text-violet-200">
              <span class="text-emerald-400 select-none">$ </span>
              <span id="hero-install-cmd" class="text-white font-bold">
                helm install my-db helmforge/postgresql
              </span>
            </div>

            <div class="pt-3 text-[11px] text-zinc-300 flex flex-wrap items-center gap-x-4 gap-y-1 select-none">
              <span class="text-emerald-300 flex items-center gap-1 font-medium">✓ Non-root container</span>
              <span class="text-emerald-300 flex items-center gap-1 font-medium">✓ S3 backup CronJob</span>
              <span class="text-emerald-300 flex items-center gap-1 font-medium">✓ NetworkPolicy</span>
            </div>
          </div>

          <div
            id="terminal-cursor"
            class="inline-block w-[8px] h-[17px] bg-emerald-400 animate-[blink_1s_step-end_infinite] align-middle ml-0.5 hidden"
          ></div>
        </div>

        <!-- Terminal Footer Actions -->
        <div class="px-4 py-3 bg-[#12161f] border-t border-white/5 flex items-center justify-between text-xs">
          <a
            id="hero-studio-link"
            href="/playground?chart=postgresql"
            class="inline-flex items-center gap-1.5 text-violet-300 hover:text-white hover:underline font-semibold"
          >
            Customize in Values Studio
            <ArrowRight class="w-3.5 h-3.5" />
          </a>

          <button
            id="hero-copy-cmd-btn"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-primary hover:bg-primary-light text-white font-bold transition-all shadow-md cursor-pointer"
          >
            <Copy class="w-3.5 h-3.5" />
            <span id="hero-copy-cmd-text">Copy Command</span>
          </button>
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  // Quick-switcher tabs logic
  const tabs = document.querySelectorAll('.hero-app-tab');
  const installCmd = document.getElementById('hero-install-cmd');
  const studioLink = document.getElementById('hero-studio-link') as HTMLAnchorElement | null;
  const copyBtn = document.getElementById('hero-copy-cmd-btn');
  const copyText = document.getElementById('hero-copy-cmd-text');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.remove('bg-violet-600/30', 'text-violet-200', 'font-bold', 'border', 'border-violet-500/40');
        t.classList.add('text-zinc-300');
      });
      tab.classList.remove('text-zinc-300');
      tab.classList.add('bg-violet-600/30', 'text-violet-200', 'font-bold', 'border', 'border-violet-500/40');

      const app = tab.getAttribute('data-app') || 'postgresql';

      if (installCmd) {
        installCmd.textContent = `helm install my-${app} helmforge/${app}`;
      }
      if (studioLink) {
        studioLink.href = `/playground?chart=${app}`;
      }
    });
  });

  if (copyBtn && copyText && installCmd) {
    copyBtn.addEventListener('click', async () => {
      const fullCmd = `helm repo add helmforge https://repo.helmforge.dev && helm repo update && ${installCmd.textContent}`;
      try {
        await navigator.clipboard.writeText(fullCmd);
        copyText.textContent = 'Copied!';
        setTimeout(() => {
          copyText.textContent = 'Copy Command';
        }, 2000);
      } catch {
        copyText.textContent = 'Copied!';
      }
    });
  }
</script>
