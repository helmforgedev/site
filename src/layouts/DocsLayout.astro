---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/Container.astro';
import { sidebarNav, chartCategories, allPages } from '../data/navigation';
import { chartCount, charts } from '../data/charts';
import ChartSchemaReference from '../components/ChartSchemaReference.astro';
import ChartArchitecture from '../components/ChartArchitecture.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props.frontmatter || Astro.props;

const currentPath = Astro.url.pathname;

// Detect if this is a chart docs page
const isChartDoc = currentPath.startsWith('/docs/charts/');
const chartSlug = isChartDoc ? currentPath.split('/docs/charts/')[1]?.replace(/\/$/, '') : null;
const chartInfo = chartSlug ? charts.find((c) => c.slug === chartSlug) : null;

const currentIndex = allPages.findIndex((p) => currentPath.replace(/\/$/, '') === p.href.replace(/\/$/, ''));
const prevPage = currentIndex > 0 ? allPages[currentIndex - 1] : null;
const nextPage = currentIndex < allPages.length - 1 ? allPages[currentIndex + 1] : null;

// Build breadcrumbs
const segments = currentPath.split('/').filter(Boolean);
const breadcrumbs = segments.map((seg, i) => ({
  label: seg.charAt(0).toUpperCase() + seg.slice(1).replace(/-/g, ' '),
  href: '/' + segments.slice(0, i + 1).join('/'),
  isLast: i === segments.length - 1,
}));

// Edit on GitHub link
const pathSlug = currentPath.replace(/\/$/, '').replace(/^\//, '');
const editUrl =
  isChartDoc && chartSlug
    ? `https://github.com/helmforgedev/charts/edit/main/charts/${chartSlug}/README.md`
    : `https://github.com/helmforgedev/site/edit/main/src/pages/${pathSlug || 'index'}.mdx`;

// Breadcrumb JSON-LD
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://helmforge.dev/' },
    ...breadcrumbs.map((crumb, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: crumb.label,
      ...(crumb.isLast ? {} : { item: `https://helmforge.dev${crumb.href}` }),
    })),
  ],
};

const maturityDot: Record<string, string> = {
  stable: 'bg-green-400',
  beta: 'bg-amber-400',
  alpha: 'bg-red-400',
};

function isActive(href: string): boolean {
  const clean = currentPath.replace(/\/$/, '');
  const target = href.replace(/\/$/, '');
  return clean === target;
}

// TechArticle JSON-LD for individual chart pages
const isChartPage =
  currentPath.includes('/docs/charts/') && currentPath.split('/').length >= 4 && !currentPath.endsWith('/charts');
const chartSlugLd = isChartPage ? currentPath.split('/').pop() : null;
const chartDisplayLd = chartSlugLd ? chartSlugLd.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()) : null;

const techArticleJsonLd = isChartPage
  ? {
      '@context': 'https://schema.org',
      '@type': 'TechArticle',
      headline: title,
      description: description,
      url: `https://helmforge.dev${currentPath}`,
      inLanguage: 'en',
      publisher: {
        '@type': 'Organization',
        name: 'HelmForge',
        url: 'https://helmforge.dev',
        logo: 'https://helmforge.dev/helmforge-logo-horizontal.svg',
      },
      about: {
        '@type': 'SoftwareApplication',
        name: chartDisplayLd,
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Kubernetes',
        url: `https://helmforge.dev${currentPath}`,
      },
      isPartOf: {
        '@type': 'WebSite',
        name: 'HelmForge',
        url: 'https://helmforge.dev',
        description: `${chartCount}+ production-ready Helm charts for Kubernetes`,
      },
    }
  : null;
---

<BaseLayout title={title} description={description} includeBreadcrumbSchema={false}>
  <Header />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)}></script>
  {techArticleJsonLd && <script type="application/ld+json" set:html={JSON.stringify(techArticleJsonLd)}></script>}

  <Container class="w-full min-w-0 py-6 sm:py-8">
    <!-- Mobile sidebar toggle -->
    <button
      id="docs-sidebar-toggle"
      class="lg:hidden mb-4 flex items-center gap-2 rounded-xl border border-border bg-bg-surface px-3 py-2 text-sm font-medium text-text-muted transition-colors hover:bg-bg-surface/80"
      aria-label="Toggle sidebar navigation"
      aria-expanded="false"
      aria-controls="docs-sidebar"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      Menu
    </button>

    <div class="lg:grid lg:grid-cols-[248px_minmax(0,1fr)] lg:gap-12">
      <!-- Sidebar -->
      <aside id="docs-sidebar" class="hidden lg:block relative z-10 w-full mb-8">
        <nav class="sticky top-24 space-y-5 rounded-2xl glass-panel p-4 pb-8 max-h-[calc(100vh-7rem)] overflow-y-auto">
          <!-- Search shortcut -->
          <button
            id="docs-search-trigger"
            class="w-full flex items-center gap-2 rounded-xl border border-border bg-bg-base/50 px-3 py-2.5 text-sm text-text-muted transition-colors hover:border-primary/30 hover:text-text-base"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              ></path>
            </svg>
            <span class="flex-1 text-left">Search docs...</span>
            <kbd class="hidden lg:inline-flex text-[10px] font-mono border border-border rounded px-1.5 py-0.5 bg-bg-surface">
              <span id="docs-search-mod">Ctrl</span>K
            </kbd>
          </button>

          <!-- Breadcrumbs (desktop) -->
          <nav aria-label="Breadcrumb" class="hidden lg:block border-b border-border pb-4">
            <ol class="flex flex-wrap items-center gap-1.5 text-sm text-text-muted">
              <li>
                <a href="/" class="hover:text-primary-light transition-colors">
                  Home
                </a>
              </li>
              {breadcrumbs.map((crumb) => (
                <li class="flex items-center gap-1.5">
                  <span class="text-text-muted/50" aria-hidden="true">
                    /
                  </span>
                  {crumb.isLast ? (
                    <span class="text-text-base font-bold" aria-current="page">
                      {crumb.label}
                    </span>
                  ) : (
                    <a href={crumb.href} class="hover:text-primary-light transition-colors">
                      {crumb.label}
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </nav>

          <div>
            <div class="mb-2 px-2 text-[11px] font-bold uppercase tracking-[0.18em] text-text-muted">Documentation</div>
            <ul class="space-y-1">
              <li>
                <a
                  href="/docs"
                  class:list={[
                    'block rounded-lg px-3 py-2 text-sm transition-colors',
                    isActive('/docs')
                      ? 'bg-primary/20 text-primary-light font-bold'
                      : 'text-text-muted hover:bg-text-base/5 hover:text-text-base',
                  ]}
                  aria-current={isActive('/docs') ? 'page' : undefined}
                >
                  Overview
                </a>
              </li>
              {sidebarNav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      'block rounded-lg px-3 py-2 text-sm transition-colors',
                      isActive(item.href)
                        ? 'bg-primary/20 text-primary-light font-bold'
                        : 'text-text-muted hover:bg-text-base/5 hover:text-text-base',
                    ]}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Categorized charts -->
          <div>
            <div class="mb-2 flex items-center justify-between px-2">
              <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-text-muted">Charts</div>
              <a
                href="/docs/charts"
                class="text-[10px] font-medium text-primary hover:text-primary-dark transition-colors uppercase tracking-wider"
              >
                View all
              </a>
            </div>
            {chartCategories.map((cat) => (
              <div class="mb-3">
                <div class="px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-text-muted">
                  {cat.label}
                </div>
                <ul class="space-y-0.5">
                  {cat.charts.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class:list={[
                          'flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm transition-colors',
                          isActive(item.href)
                            ? 'bg-primary/20 text-primary-light font-bold'
                            : 'text-text-muted hover:bg-text-base/5 hover:text-text-base',
                        ]}
                        aria-current={isActive(item.href) ? 'page' : undefined}
                      >
                        <span
                          class={`w-1.5 h-1.5 rounded-full shrink-0 ${maturityDot[item.maturity]}`}
                          title={item.maturity}
                        />
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </nav>
      </aside>

      <!-- Main content -->
      <main id="main-content" class="min-w-0" data-pagefind-body>
        <!-- Breadcrumbs (mobile) -->
        <nav aria-label="Breadcrumb" class="mb-6 lg:hidden">
          <ol class="flex flex-wrap items-center gap-1.5 text-sm text-text-muted">
            <li>
              <a href="/" class="hover:text-primary-light transition-colors">
                Home
              </a>
            </li>
            {breadcrumbs.map((crumb) => (
              <li class="flex items-center gap-1.5">
                <span class="text-text-muted/50" aria-hidden="true">
                  /
                </span>
                {crumb.isLast ? (
                  <span class="text-text-base font-bold" aria-current="page">
                    {crumb.label}
                  </span>
                ) : (
                  <a href={crumb.href} class="hover:text-primary-light transition-colors">
                    {crumb.label}
                  </a>
                )}
              </li>
            ))}
          </ol>
        </nav>

        {chartInfo && (
          <div class="mb-6 rounded-2xl border border-primary/20 bg-bg-surface/80 backdrop-blur-md p-5 shadow-lg">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-bg-base border border-border/80 flex items-center justify-center p-2 shadow-sm shrink-0">
                  <img
                    src={`/icons/charts/${chartInfo.slug}.png`}
                    alt={`${chartInfo.name} icon`}
                    class="w-full h-full object-contain"
                    onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  />
                  <div class="w-full h-full hidden items-center justify-center rounded bg-primary/10 text-primary font-bold text-xs uppercase">
                    {chartInfo.name.substring(0, 2)}
                  </div>
                </div>
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="text-xs font-mono font-bold px-2 py-0.5 rounded-md bg-primary/10 text-primary border border-primary/20">
                      v{chartInfo.version}
                    </span>
                    <span class="text-xs font-mono text-text-muted px-2 py-0.5 rounded-md bg-bg-base border border-border">
                      App: v{chartInfo.appVersion}
                    </span>
                    <span class="text-[11px] font-semibold text-emerald-800 dark:text-emerald-300 px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20">
                      Pinned Digest
                    </span>
                    {chartInfo.backup !== 'none' && (
                      <span class="text-[11px] font-semibold text-sky-800 dark:text-sky-300 px-2 py-0.5 rounded-md bg-sky-50 dark:bg-sky-500/10 border border-sky-200 dark:border-sky-500/20">
                        S3 Backup Ready
                      </span>
                    )}
                  </div>
                  <p class="text-xs text-text-muted mt-1.5">
                    Production Helm chart • Apache-2.0 • Zero-Root • Verified on Kubernetes v1.33-v1.36+
                  </p>
                </div>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <a
                  href={`/playground/${chartInfo.slug}`}
                  class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold bg-primary text-white hover:bg-primary-dark transition-all shadow-sm"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"
                    ></path>
                  </svg>
                  Values Studio
                </a>
                <a
                  href={`/stack?select=${chartInfo.slug}`}
                  class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold border border-border bg-bg-surface hover:border-primary/40 text-text-base transition-colors"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                    ></path>
                  </svg>
                  Stack Builder
                </a>
                <a
                  href={`https://github.com/helmforgedev/charts/tree/main/charts/${chartInfo.slug}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-2.5 py-2 rounded-xl text-xs font-medium text-text-muted hover:text-text-base border border-border hover:border-primary/40 transition-colors"
                  aria-label="GitHub Chart Source"
                >
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.1c-3.34.73-4.04-1.42-4.04-1.42-.55-1.38-1.33-1.75-1.33-1.75-1.08-.74.08-.73.08-.73 1.2.08 1.83 1.22 1.83 1.22 1.06 1.82 2.8 1.29 3.49.99.11-.77.42-1.29.75-1.59-2.67-.31-5.48-1.34-5.48-5.94 0-1.31.47-2.39 1.22-3.23-.12-.3-.53-1.55.12-3.22 0 0 1-.32 3.3 1.23a11.4 11.4 0 0 1 6 0c2.3-1.55 3.29-1.23 3.29-1.23.66 1.67.25 2.92.13 3.22.76.84 1.21 1.92 1.21 3.23 0 4.61-2.82 5.63-5.51 5.93.43.38.81 1.1.81 2.22v3.29c0 .32.22.7.82.58A12 12 0 0 0 12 .5Z" />
                  </svg>
                  Source
                </a>
              </div>
            </div>
          </div>
        )}

        <article class="glass-panel rounded-2xl px-5 py-8 sm:px-8 lg:px-10">
          <div class="prose prose-docs max-w-5xl">
            <slot />
          </div>

          {chartInfo && <ChartArchitecture chartSlug={chartInfo.slug} />}

          {chartInfo && <ChartSchemaReference slug={chartInfo.slug} chartName={chartInfo.name} />}

          <!-- Edit on GitHub -->
          <div class="mt-10 pt-6 border-t border-border flex items-center gap-2 text-sm text-text-muted">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
              ></path>
            </svg>
            <a
              href={editUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-primary-light transition-colors"
            >
              Edit this page on GitHub
            </a>
          </div>
        </article>

        <!-- Prev / Next navigation -->
        <nav class="mt-8 grid gap-3 border-t border-border pt-6 sm:grid-cols-2">
          {prevPage ? (
            <a
              href={prevPage.href}
              class="group flex min-h-[84px] flex-col justify-center rounded-2xl glass-panel px-5 py-4 text-sm transition-colors hover:border-primary/50"
            >
              <span class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.16em] text-text-muted">
                <svg
                  class="w-4 h-4 transition-transform group-hover:-translate-x-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                Previous
              </span>
              <span class="mt-2 text-base font-bold text-text-base group-hover:text-primary-light transition-colors">
                {prevPage.label}
              </span>
            </a>
          ) : (
            <span class="hidden sm:block" />
          )}
          {nextPage ? (
            <a
              href={nextPage.href}
              class="group flex min-h-[84px] flex-col justify-center rounded-2xl glass-panel px-5 py-4 text-sm transition-colors hover:border-primary/50 sm:text-right"
            >
              <span class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.16em] text-text-muted sm:justify-end">
                Next
                <svg
                  class="w-4 h-4 transition-transform group-hover:translate-x-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </span>
              <span class="mt-2 text-base font-bold text-text-base group-hover:text-primary-light transition-colors">
                {nextPage.label}
              </span>
            </a>
          ) : (
            <span class="hidden sm:block" />
          )}
        </nav>
      </main>
    </div>
  </Container>

  <Footer />

  <script>
    import '../scripts/docs-interactive';
  </script>
</BaseLayout>
